# Secrets — never commit an API key or an environment file.
.env
.env.*
!.env.example

# Built data artifacts (downloaded/generated at build time, never redistributed).
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.npy

# Local config and caches (the model cache lives under ~/.cache/cinegeist/).
.cache/

# Python.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Web demo (later sessions).
node_modules/
web/dist/
# The generated shard (web/public/shard/) is committed on purpose — the demo loads it and Pages
# serves it (plan.md §8.3). It is small (~280 KB) and regenerated by `make web-shard`.

# Editor / OS noise.
.idea/
.vscode/
.DS_Store
Thumbs.db
