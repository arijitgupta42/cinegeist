# Copy this file to `.env` and fill in your key, or export the variable in your shell.
# The key is read from the environment only. cinegeist never writes it to a file,
# never logs it, and redacts it in error output. `.env` is gitignored.

# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Your TMDB credential, used to enrich the catalog (keywords, credits, providers).
# Either a v3 API key or a v4 read access token works. Get one at
# https://www.themoviedb.org/settings/api . Read from the environment only, never logged.
# TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=

# Optional. Pin a model instead of auto-selecting a free one.
# Precedence: --model flag > CINEGEIST_MODEL > config.toml > auto-pick free.
# CINEGEIST_MODEL=

# Optional. Override the API base URL (rarely needed).
# CINEGEIST_API_BASE=https://openrouter.ai/api/v1
